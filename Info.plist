<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>AutoAgent Status</string>
	<key>CFBundleExecutable</key>
	<string>AutoAgentStatus</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>vn.saigontechnology.autoagent-status</string>
	<key>CFBundleName</key>
	<string>AutoAgent Status</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.17.0</string>
	<key>CFBundleVersion</key>
	<string>1.17.0</string>
	<!-- The Token Rank board is served over plain HTTP from a bare IP, so ATS
	     would refuse the report with no error the app can see. The exception is
	     scoped to that one host: everything else still goes through ATS. Point
	     the board at a different http:// host and this list has to name it too. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>116.118.6.26</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
